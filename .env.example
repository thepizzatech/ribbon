# Copy to .env next to docker-compose.yml. Everything here is optional.

# Which host port to publish (the app always listens on 8080 inside the container).
#PORT=8080

# Which image to run: latest (newest release), dev (newest main), or a version like 0.3.0-beta.1.
#RIBBON_TAG=latest

# When Ribbon is behind an HTTPS reverse proxy: the address people type.
#PUBLIC_URL=https://ribbon.example.com

# Show the guided tour on every sign-in until someone finishes it (handy while testing).
#TOUR_ALWAYS=true

# Load a sample household into a brand-new database (testing only).
#SEED_SAMPLE_DATA=false

# Require a code to create the first owner login. Strongly recommended whenever the server can be
# reached from outside your home network: until the first owner exists, anyone who can open the page
# could claim it. Without a code, the first owner can only be created from your home network.
#SETUP_CODE=

# Let the first owner be created from a public address with no SETUP_CODE (not recommended).
#ALLOW_PUBLIC_SETUP=false

# Turn on the Ask page.
#XAI_API_KEY=

# Single sign-on (OpenID Connect). Callback address: <PUBLIC_URL>/api/auth/oidc/callback
#OIDC_ISSUER=https://id.example.com
#OIDC_CLIENT_ID=ribbon
#OIDC_CLIENT_SECRET=
#DISABLE_PASSWORD_LOGIN=false

# Scheduled backups: cron (minute hour day month weekday) or "off", and how many to keep.
#BACKUP_CRON=0 3 * * *
#BACKUP_KEEP=14

# ---- Calendars (Settings > Calendars) ----

# Key for the calendar logins Ribbon stores (Google tokens, CalDAV passwords, secret calendar links).
# Optional: without it Ribbon makes a random key and keeps it in DATA_DIR/app-secret. Set it if you
# restore backups onto a different machine (backups do not contain the key file).
#APP_SECRET=

# Sign in with Google (read-only calendar). Create an OAuth client first: docs/calendars.md
# Redirect URI to register: <PUBLIC_URL>/api/calendars/google/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# How often connected calendars refresh, in hours (1 to 168), and how many each person may connect.
#CALENDAR_SYNC_HOURS=6
#CALENDAR_MAX_CONNECTIONS=10

# Turn the background refresh off (people can still press "Sync now").
#CALENDAR_SYNC=true

# Let calendar links and CalDAV servers on your own network (192.168.x.x, localhost, ...) be added.
# Off by default: Ribbon refuses private and internal addresses so a calendar link can't be used to
# reach other things on your network.
#ALLOW_PRIVATE_CALENDAR_URLS=false
